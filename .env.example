# ============================================================
#  تنظیمات سایت فروشگاهی | Arian Shop
#  این فایل را به نام .env کپی کنید و در صورت نیاز ویرایش کنید
#  (docker compose خودش مقدارهای پیش‌فرض را جایگزین می‌کند)
# ============================================================

# آدرس سایت (اگر پورت 8080 را تغییر دادید همین‌جا اصلاح کنید)
SITE_URL=http://localhost:8080

# اطلاعات مدیر وردپرس (پس از نصب از همین‌ها ساخته می‌شود)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=Admin@1234
WP_ADMIN_EMAIL=admin@arian-shop.local

# اطلاعات دیتابیس
DB_NAME=arian
DB_USER=arian
DB_PASSWORD=arian_pass_2026
DB_ROOT_PASSWORD=root_secret_2026

# پورت دسترسی سایت روی سیستم شما
WEB_PORT=8080
